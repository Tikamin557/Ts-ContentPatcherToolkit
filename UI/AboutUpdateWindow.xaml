<Window x:Class="TsCPToolKit.UI.AboutUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App_Name}"
        Icon="/Resources/TsCPToolKit.png"
        Width="540"
        Height="330"
        MinWidth="480"
        MinHeight="300"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="16"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="16"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="16"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Application name -->
		<TextBlock
            Grid.Row="0"
            Text="{DynamicResource App_Name}"
            FontSize="22"
            FontWeight="SemiBold"
            TextWrapping="Wrap"/>

		<!-- Version information -->
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="16"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="10"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Text="{DynamicResource AboutUpdate_CurrentVersion}"
                FontWeight="SemiBold"/>

			<TextBlock
                x:Name="CurrentVersionTextBlock"
                Grid.Row="0"
                Grid.Column="2"
                Text="-"/>

			<TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Text="{DynamicResource AboutUpdate_LatestVersion}"
                FontWeight="SemiBold"/>

			<TextBlock
                x:Name="LatestVersionTextBlock"
                Grid.Row="2"
                Grid.Column="2"
                Text="{DynamicResource AboutUpdate_NotChecked}"/>
		</Grid>

		<!-- Update status -->
		<Border
            Grid.Row="4"
            Padding="12"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            BorderThickness="1"
            CornerRadius="4">

			<TextBlock
                x:Name="UpdateStatusTextBlock"
                Text="{DynamicResource AboutUpdate_NotCheckedStatus}"
                TextWrapping="Wrap"/>
		</Border>

		<StackPanel
    Grid.Row="6"
    Orientation="Horizontal"
    HorizontalAlignment="Right">

			<Button
				x:Name="OpenNexusButton"
				MinWidth="160"
				MinHeight="36"
				Margin="0,0,10,0"
				Padding="12,4"
				Content="{DynamicResource AboutUpdate_OpenNexusButton}"
				IsEnabled="False"
				Click="OpenNexusButton_Click"/>

			<Button
				x:Name="CloseButton"
				MinWidth="100"
				MinHeight="36"
				Padding="12,4"
				Content="{DynamicResource AboutUpdate_Close}"
				IsCancel="True"
				Click="CloseButton_Click"/>

		</StackPanel>
	</Grid>
</Window>