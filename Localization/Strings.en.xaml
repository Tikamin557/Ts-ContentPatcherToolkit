	<sys:String x:Key="Single_EncodingErrorMessage">The file encoding could not be read correctly.</sys:String>

	<sys:String x:Key="Single_AccessErrorTitle">Access Error</sys:String>
	<sys:String x:Key="Single_AccessErrorMessage">Access to the file was denied.</sys:String>

	<sys:String x:Key="Single_ReadWriteErrorMessage">An error occurred while reading or writing the file.</sys:String>

	<sys:String x:Key="Single_UnexpectedErrorTitle">Error</sys:String>
	<sys:String x:Key="Single_UnexpectedErrorMessage">An unexpected error occurred while adjusting the indentation.</sys:String>

	<sys:String x:Key="Single_BrowseDialogTitle">Select a JSON file to process</sys:String>

