	<sys:String x:Key="AboutUpdate_NotCheckedStatus">Update information has not been checked yet.</sys:String>

	<sys:String x:Key="AboutUpdate_Close">Close</sys:String>

	<!-- Update check -->
	<sys:String x:Key="AboutUpdate_OpenNexusButton">Open Nexus Mods Page</sys:String>

	<sys:String x:Key="AboutUpdate_Checking">Checking for updates...</sys:String>
