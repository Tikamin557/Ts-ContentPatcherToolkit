<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

	<!-- Application -->
	<sys:String x:Key="App_Name">T's Content Patcher Toolkit</sys:String>

	<!-- Languages -->
	<sys:String x:Key="Language_Label">Language:</sys:String>
	<sys:String x:Key="Language_English">English</sys:String>
	<sys:String x:Key="Language_Japanese">日本語</sys:String>

	<!-- Common settings -->
	<sys:String x:Key="Common_IndentSize">Indent size:</sys:String>
	<sys:String x:Key="Common_Spaces">spaces</sys:String>
	<sys:String x:Key="Common_CreateBackup">Create a backup file (.bak) before processing</sys:String>
	<sys:String x:Key="Common_Browse">Browse...</sys:String>

	<!-- Main description -->
	<sys:String x:Key="Main_Description">Adjusts only the indentation at the beginning of each line without changing line breaks or the contents of each line.</sys:String>

	<!-- Single file tab -->
	<sys:String x:Key="Single_Tab">JSON File</sys:String>
	<sys:String x:Key="Single_Description">Select one JSON file to adjust its indentation. You can also drag and drop a JSON file onto this window.</sys:String>
	<sys:String x:Key="Single_FileToolTip">JSON file to process</sys:String>
	<sys:String x:Key="Single_ProcessButton">Adjust Indentation</sys:String>
	<sys:String x:Key="Single_InitialStatus">Select a JSON file or drag and drop one onto this window.</sys:String>

	<sys:String x:Key="Single_OpenFolderButton">Open Selected Folder</sys:String>
	<sys:String x:Key="Single_OpenFolderMissing">The folder containing the selected JSON file could not be found.</sys:String>
	<sys:String x:Key="Single_OpenFolderErrorTitle">Folder Error</sys:String>
	
	<!-- Batch tab -->
	<sys:String x:Key="Batch_Tab">Batch Processing</sys:String>
	<sys:String x:Key="Batch_Description">Process multiple JSON files in the selected folder. You can also drag and drop a folder onto this window.</sys:String>
	<sys:String x:Key="Batch_FolderToolTip">Folder containing JSON files to process</sys:String>
	<sys:String x:Key="Batch_IncludeSubfolders">Also process JSON files in subfolders</sys:String>
	<sys:String x:Key="Batch_ProcessButton">Process JSON Files in Folder</sys:String>
	<sys:String x:Key="Batch_InitialStatus">Select a folder to process.</sys:String>

	<sys:String x:Key="Batch_OpenFolderButton">Open Selected Folder</sys:String>
	<sys:String x:Key="Batch_OpenFolderMissing">The selected folder could not be found.</sys:String>
	<sys:String x:Key="Batch_OpenFolderErrorTitle">Folder Error</sys:String>

	<!-- Test tab -->
	<sys:String x:Key="Test_Tab">Tests</sys:String>
	<sys:String x:Key="Test_Description">Process the JSON files in Input, generate the results in Output, and compare them with Expected.</sys:String>
	<sys:String x:Key="Test_FolderToolTip">Tests folder containing Input, Output, and Expected</sys:String>
	<sys:String x:Key="Test_RunButton">Run Tests</sys:String>
	<sys:String x:Key="Test_UpdateExpectedButton">Copy Output to Expected</sys:String>
	<sys:String x:Key="Test_ResultHeader">Test Results</sys:String>
	<sys:String x:Key="Test_InitialStatus">Select the Tests folder and run the tests.</sys:String>

	<sys:String x:Key="Test_OpenFolderButton">Open Selected Folder</sys:String>
	<sys:String x:Key="Test_OpenFolderMissing">The selected Tests folder could not be found.</sys:String>
	<sys:String x:Key="Test_OpenFolderErrorTitle">Folder Error</sys:String>

	<!-- Common messages -->
	<sys:String x:Key="Common_InvalidIndentSizeMessage">Please select a valid indent size.</sys:String>
	<sys:String x:Key="Common_SettingsErrorTitle">Settings Error</sys:String>
	<sys:String x:Key="Common_CheckIndentSizeStatus">Please check the indent size.</sys:String>

	<!-- Single file messages -->
	<sys:String x:Key="Single_SelectFileMessage">Please select a JSON file to process.</sys:String>
	<sys:String x:Key="Single_SelectFileTitle">No File Selected</sys:String>
	<sys:String x:Key="Single_SelectFileStatus">Please select a JSON file.</sys:String>

	<sys:String x:Key="Single_FileNotFoundMessage">The selected file could not be found.</sys:String>
	<sys:String x:Key="Single_FileErrorTitle">File Error</sys:String>
	<sys:String x:Key="Single_FileNotFoundStatus">The selected file could not be found.</sys:String>

	<sys:String x:Key="Single_ProcessingStatus">Adjusting indentation...</sys:String>

	<sys:String x:Key="Single_NoChangeMessage">The indentation in this file is already properly formatted.</sys:String>
	<sys:String x:Key="Single_NoChangeTitle">No Changes</sys:String>
	<sys:String x:Key="Single_NoChangeStatus">No changes were necessary.</sys:String>

	<sys:String x:Key="Single_CompleteTitle">Complete</sys:String>
	<sys:String x:Key="Single_CompleteMessage">Indentation adjustment is complete.</sys:String>
	<sys:String x:Key="Single_ProcessedFileLabel">Processed file:</sys:String>
	<sys:String x:Key="Single_BackupLabel">Backup:</sys:String>
	<sys:String x:Key="Single_CompleteStatus">Completed:</sys:String>

