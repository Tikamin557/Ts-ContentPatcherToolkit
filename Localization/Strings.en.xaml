	<sys:String x:Key="TestService_Passed">The output matches the expected result.</sys:String>
	<sys:String x:Key="TestService_FirstDifference">First difference: </sys:String>
	<sys:String x:Key="TestService_LineSuffix"> line</sys:String>
	<sys:String x:Key="TestService_InputFolderNotFound">The Input folder could not be found.</sys:String>

	<!-- Internal messages -->
	<sys:String x:Key="Internal_FileNotFound">The specified file could not be found.</sys:String>
	<sys:String x:Key="Internal_InvalidBomLength">BOM length must be zero or greater.</sys:String>
	<sys:String x:Key="Internal_InvalidLineNumber">Line number must be zero or greater.</sys:String>
	<sys:String x:Key="Internal_InvalidIndentSize">Indent size must be zero or greater.</sys:String>

