	<sys:String x:Key="Internal_BackupSourceNotFound">The source file for the backup could not be found.</sys:String>
	<sys:String x:Key="Internal_InvalidLineNumberOneBased">Line number must be 1 or greater.</sys:String>

	<sys:String x:Key="Status_SelectedFolder">Selected folder:</sys:String>
	<sys:String x:Key="Status_SelectedTestsFolder">Selected Tests folder:</sys:String>
	<sys:String x:Key="Status_SelectedFile">Selected file:</sys:String>

