	<sys:String x:Key="Test_UpdateExpectedCompleteTitle">Expected Updated</sys:String>

	<sys:String x:Key="Test_UpdateExpectedErrorMessage">An error occurred while updating Expected.</sys:String>
	<sys:String x:Key="Test_UpdateExpectedErrorTitle">Expected Update Error</sys:String>

	<sys:String x:Key="Test_NoInputFiles">No JSON files were found in the Input folder.</sys:String>

	<sys:String x:Key="Test_CountLabel">Tests:</sys:String>
	<sys:String x:Key="Test_PassLabel">PASS:</sys:String>
	<sys:String x:Key="Test_FailLabel">FAIL:</sys:String>
