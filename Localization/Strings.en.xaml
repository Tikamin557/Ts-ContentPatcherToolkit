	<sys:String x:Key="Batch_SelectFolderStatus">Please select a folder to process.</sys:String>

	<sys:String x:Key="Batch_FolderNotFoundMessage">The selected folder could not be found.</sys:String>
	<sys:String x:Key="Batch_FolderErrorTitle">Folder Error</sys:String>
	<sys:String x:Key="Batch_FolderNotFoundStatus">The selected folder could not be found.</sys:String>

	<sys:String x:Key="Batch_CheckFilesErrorMessage">The JSON files to process could not be checked.</sys:String>
	<sys:String x:Key="Batch_CheckFilesErrorTitle">Folder Check Error</sys:String>

	<sys:String x:Key="Batch_NoJsonMessage">No JSON files were found in the selected folder.</sys:String>
	<sys:String x:Key="Batch_NoJsonTitle">No JSON Files Found</sys:String>
	<sys:String x:Key="Batch_NoJsonStatus">No JSON files were found to process.</sys:String>

	<sys:String x:Key="Batch_ConfirmTitle">Confirm Batch Processing</sys:String>
	<sys:String x:Key="Batch_ConfirmIntro">The JSON files in this folder will be processed.</sys:String>
	<sys:String x:Key="Batch_TargetFolderLabel">Target folder:</sys:String>
	<sys:String x:Key="Batch_TargetCountLabel">Files to process:</sys:String>
	<sys:String x:Key="Batch_SearchRangeLabel">Search range:</sys:String>
	<sys:String x:Key="Batch_BackupLabel">Backup:</sys:String>
	<sys:String x:Key="Batch_SubfoldersIncluded">Include subfolders</sys:String>
	<sys:String x:Key="Batch_CurrentFolderOnly">Selected folder only</sys:String>
	<sys:String x:Key="Batch_BackupCreate">Create</sys:String>
	<sys:String x:Key="Batch_BackupDoNotCreate">Do not create</sys:String>
	<sys:String x:Key="Batch_OverwriteWarning">JSON files that require changes will be overwritten.</sys:String>
	<sys:String x:Key="Batch_ContinueQuestion">Do you want to continue?</sys:String>

	<sys:String x:Key="Batch_ProcessingStatus">Processing JSON files in the folder...</sys:String>

	<sys:String x:Key="Batch_CompleteText">Batch processing is complete.</sys:String>
	<sys:String x:Key="Batch_TotalLabel">Total:</sys:String>
	<sys:String x:Key="Batch_ChangedLabel">Changed:</sys:String>
	<sys:String x:Key="Batch_UnchangedLabel">Unchanged:</sys:String>
	<sys:String x:Key="Batch_ErrorLabel">Errors:</sys:String>
	<sys:String x:Key="Batch_ErrorFilesHeader">Files with errors:</sys:String>

	<sys:String x:Key="Batch_CompleteTitle">Batch Processing Complete</sys:String>
	<sys:String x:Key="Batch_ErrorDetailsNotice">See the result area for error details.</sys:String>

	<sys:String x:Key="Batch_ProcessErrorMessage">An error occurred during batch processing.</sys:String>
	<sys:String x:Key="Batch_ProcessErrorTitle">Batch Processing Error</sys:String>

	<!-- Test messages -->
	<sys:String x:Key="Test_BrowseDialogTitle">Select the Tests folder containing Input, Output, and Expected</sys:String>

	<sys:String x:Key="Test_RunningStatus">Running tests...</sys:String>
	<sys:String x:Key="Test_RunErrorMessage">An error occurred while running the tests.</sys:String>
	<sys:String x:Key="Test_RunErrorTitle">Test Error</sys:String>

	<sys:String x:Key="Test_OutputFolderMissingMessage">The Output folder could not be found.</sys:String>
	<sys:String x:Key="Test_RunFirstMessage">Please run the tests first.</sys:String>
	<sys:String x:Key="Test_OutputFolderMissingTitle">Output Folder Not Found</sys:String>

	<sys:String x:Key="Test_NoOutputFilesMessage">There are no JSON files in the Output folder.</sys:String>
	<sys:String x:Key="Test_NoFilesToCopyTitle">No Files to Copy</sys:String>

	<sys:String x:Key="Test_UpdateExpectedConfirmIntro">The JSON files in Output will be copied to Expected.</sys:String>
	<sys:String x:Key="Test_TargetFileCountLabel">Files to copy:</sys:String>
