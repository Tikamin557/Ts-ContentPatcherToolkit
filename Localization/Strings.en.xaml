	<sys:String x:Key="Test_CompleteTitle">Tests Complete</sys:String>
	<sys:String x:Key="Test_FailPrefix">FAIL:</sys:String>
	<sys:String x:Key="Test_ErrorPrefix">ERROR:</sys:String>
	<sys:String x:Key="Test_MoreFailuresPart1">There are</sys:String>
	<sys:String x:Key="Test_MoreFailuresPart2">additional failed tests.</sys:String>
	<sys:String x:Key="Test_MoreErrorsPart1">There are</sys:String>
	<sys:String x:Key="Test_MoreErrorsPart2">additional errors.</sys:String>
	<sys:String x:Key="Test_SeeResults">See the test results area for details.</sys:String>

	<sys:String x:Key="Test_SelectFolderMessage">Please select the Tests folder.</sys:String>
	<sys:String x:Key="Test_SelectFolderTitle">No Folder Selected</sys:String>
	<sys:String x:Key="Test_FolderNotFoundMessage">The selected Tests folder could not be found.</sys:String>
	<sys:String x:Key="Test_FolderErrorTitle">Folder Error</sys:String>
	<sys:String x:Key="Test_InputFolderMissingMessage">The selected folder does not contain an Input folder.</sys:String>
	<sys:String x:Key="Test_InputFolderHelp">Select the Tests folder that contains Input, Output, and Expected.</sys:String>
	<sys:String x:Key="Test_InputFolderMissingTitle">Input Folder Not Found</sys:String>

	<!-- Drag and drop messages -->
	<sys:String x:Key="DragDrop_InvalidMessage">Drop one JSON file or one folder only.</sys:String>
	<sys:String x:Key="DragDrop_InvalidTitle">Cannot Drop</sys:String>
	<sys:String x:Key="DragDrop_FileStatus">Dropped file:</sys:String>
	<sys:String x:Key="DragDrop_FolderStatus">Dropped folder:</sys:String>

