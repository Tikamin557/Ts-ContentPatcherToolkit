	<sys:String x:Key="BatchService_FolderNotFound">The specified folder could not be found.</sys:String>
	<sys:String x:Key="BatchService_AlreadyFormatted">Already formatted.</sys:String>
	<sys:String x:Key="BatchService_Formatted">Indentation adjusted.</sys:String>

