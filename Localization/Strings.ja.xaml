	<sys:String x:Key="Single_AccessErrorMessage">ファイルへのアクセスが拒否されました。</sys:String>

	<sys:String x:Key="Single_ReadWriteErrorMessage">ファイルの読み書き中にエラーが発生しました。</sys:String>

	<sys:String x:Key="Single_UnexpectedErrorTitle">エラー</sys:String>
	<sys:String x:Key="Single_UnexpectedErrorMessage">インデントの整理中に予期しないエラーが発生しました。</sys:String>

	<sys:String x:Key="Single_BrowseDialogTitle">処理するJSONファイルを選択してください</sys:String>

